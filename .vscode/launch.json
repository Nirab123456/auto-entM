{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to OpenOCD GDB (ESP32S3)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/auto_entm_aurdino_as_tool.elf",
      "miDebuggerServerAddress": "localhost:3333",
      "miDebuggerPath": "C:\\Users\\rifat\\.espressif\\tools\\xtensa-esp-elf-gdb\\16.2_20250324\\xtensa-esp-elf-gdb\\bin\\xtensa-esp32s3-elf-gdb.exe",
      "cwd": "${workspaceFolder}",
      "stopAtEntry": true,
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "logging": {
        "trace": false,
        "engineLogging": false,
        "traceResponse": false
      }
    }
  ]
}
